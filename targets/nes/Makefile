# Nintendo Entertainment System - cc65 (ca65 / ld65)
#
# CHR-ROM, nametables and attribute tables are generated by tools/gen.py rather
# than written as assembly tables: the attribute table is a 16x16 palette
# constraint that has to be checked, and checking it by eye is how NES layouts
# end up with one wrong block nobody notices. See that file's docstring.

TARGET   := nes
PROGRAMS := testcard inputtest overscan

ROOT     := ../..
BUILD    := $(ROOT)/build/$(TARGET)
GEN      := $(BUILD)/gen
DIST     := $(ROOT)/dist/$(TARGET)

CA65     := ca65
LD65     := ld65
CA65FLAGS := -I src --bin-include-dir $(GEN)

ROMS     := $(PROGRAMS:%=$(DIST)/%.nes)
GENSTAMP := $(GEN)/.stamp

.PHONY: all clean
all: $(ROMS)

$(GENSTAMP): tools/gen.py $(ROOT)/tools/font.py
	@mkdir -p $(GEN)
	python3 tools/gen.py $(GEN)
	@touch $@

$(BUILD)/%.o: src/%.s src/runtime.inc $(GENSTAMP)
	@mkdir -p $(BUILD)
	$(CA65) $(CA65FLAGS) -o $@ $<

$(DIST)/%.nes: $(BUILD)/%.o nes.cfg
	@mkdir -p $(DIST)
	$(LD65) -C nes.cfg -o $@ $<
	@printf '%s: %s bytes\n' $(@F) $$(stat -f%z $@)

clean:
	rm -rf $(BUILD) $(DIST)
